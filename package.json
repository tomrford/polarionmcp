{
  "name": "polarionmcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8080",
    "start": "workerd serve config.capnp --experimental --socket-addr http=*:8080",
    "generate": "tsx scripts/generate.ts",
    "lint": "oxlint src/ scripts/ tests/",
    "lint:fix": "oxlint --fix src/ scripts/ tests/",
    "fmt": "oxfmt --write src/ scripts/ tests/",
    "fmt:check": "oxfmt --check src/ scripts/ tests/",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "check": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.3.0",
    "openapi-typescript": "^7.10.1",
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.8",
    "workerd": "^1.20260815.1",
    "wrangler": "^4.124.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
