# Full base URL of your Polarion REST API (v1)
POLARION_BASE_URL=https://polarion.example.com/polarion/rest/v1

# Optional Polarion guidance string. When unset, the baked-in default is used.
# POLARION_GUIDELINES=

# Page size for generated collection reads (uses Polarion default when unset)
# REST_PAGE_SIZE=100

# Concurrent page fetches for generated collection reads (default: 1)
# FETCH_CONCURRENCY_COUNT=5

# Serialized inline image result budget for read_attachment (default: 1000000)
# READ_ATTACHMENT_INLINE_RESULT_MAX_BYTES=1000000
