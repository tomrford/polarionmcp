# Full base URL of your Polarion REST API (v1)
POLARION_BASE_URL=https://polarion.example.com/polarion/rest/v1

# Personal access token — only needed for --stdio mode (local dev/testing)
# In HTTP mode, each client sends their own token via Authorization header
POLARION_ACCESS_TOKEN=your-token-here

# HTTP server port (only used in HTTP mode, default: 8080)
# TLS is typically terminated by a reverse proxy or load balancer in front of this container
# PORT=8080
