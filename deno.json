{
  "nodeModulesDir": "auto",
  "imports": {
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.15/bdd"
  },
  "tasks": {
    "start": "deno run --env --allow-env --allow-net --allow-read --allow-run src/main.ts",
    "start:stdio": "deno run --env --allow-env --allow-net --allow-read --allow-run src/main.ts --stdio",
    "generate": "deno run --allow-read --allow-write --allow-run scripts/generate.ts",
    "check": "POLARION_BASE_URL=https://example.invalid deno test --no-run --allow-env --allow-read --allow-run",
    "test": "POLARION_BASE_URL=https://example.invalid deno test --allow-env --allow-read --allow-run"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  }
}
